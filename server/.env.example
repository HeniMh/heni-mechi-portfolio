PORT=5001
CLIENT_URL=http://localhost:5173
# Production (Render): URL where the portfolio site is opened in the browser
# CLIENT_URL=https://heni-mechi-portfolio.onrender.com
# Optional extra origins, comma-separated (e.g. Vercel preview)
# ALLOWED_ORIGINS=https://your-site.vercel.app
CONTACT_TO=henimechi2026@gmail.com

# ── Gmail SMTP (Render + local) ───────────────────────────────────────────────
# 1. Enable 2-Step Verification on the Google account: https://myaccount.google.com/security
# 2. Create an App Password (16 characters): https://myaccount.google.com/apppasswords
#    Choose "Mail" or "Other" → name it "Portfolio"
# 3. Paste ONLY the 16-character password below (no quotes). NOT your normal Gmail password.
# 4. SMTP_USER must be the same account that created the App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=henimechi2026@gmail.com
SMTP_PASS=your-16-character-app-password
SMTP_FROM="Heni Portfolio <henimechi2026@gmail.com>"

# If 587 fails, try:
# SMTP_PORT=465
# SMTP_SECURE=true
